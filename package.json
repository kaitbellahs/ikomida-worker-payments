{
  "name": "ikomida-payments-worker",
  "version": "1.0.0",
  "description": "ikomida payments worker",
  "private": true,
  "module": "build/worker.mjs",
  "types": "build/worker.d.ts",
  "files": [
    "build"
  ],
  "type": "module",
  "scripts": {
    "worker": "node build/worker.mjs",
    "start": "pm2-runtime start process.yml",
    "build": "rimraf ./build ./build ./docs && tsc",
    "prebuild:types": "rimraf ./build",
    "build:types": "tsc -p ./tsconfig.json --outDir build && api-extractor run",
    "predoc:jsdoc": "rimraf ./docs",
    "docs:jsdoc": "jsdoc -r \"src/**/*.ts\" -R README.md -d ./docs",
    "predoc:typedoc": "rimraf ./docs",
    "docs:typedoc": "typedoc src --out docs",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint . --ext .ts --quiet --fix",
    "clean": "rimraf ./build ./build ./docs",
    "glogin": "artifactregistry-auth",
    "prepublishOnly": "yarn lint",
    "preversion": "yarn lint",
    "version": "yarn format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "author": "Khalid Ait Bellahs",
  "license": "UNLICENSED",
  "dependencies": {
    "@ikomida/shared-backend": "^0.0.233",
    "axios": "^0.27.2"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.31.2",
    "@types/amqplib": "^0.8.2",
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.14",
    "@types/http-proxy": "^1.17.9",
    "@types/linkify-it": "^3.0.2",
    "@types/luxon": "^3.0.1",
    "@types/morgan": "^1.9.3",
    "@types/node": "^18.7.21",
    "@types/node-mailjet": "^3.3.9",
    "@types/sequelize": "^4.28.14",
    "@types/sharp": "^0.31.0",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.38.0",
    "@typescript-eslint/parser": "^5.38.0",
    "chai": "^4.3.6",
    "eslint": "^8.24.0",
    "eslint-config-prettier": "^8.5.0",
    "google-artifactregistry-auth": "^3.0.2",
    "jsdoc": "^3.6.11",
    "linkify-it": "^4.0.1",
    "mocha": "^10.0.0",
    "prettier": "^2.7.1",
    "rimraf": "^3.0.2",
    "tslib": "^2.4.0",
    "typedoc": "^0.23.15",
    "typescript": "^4.8.3"
  }
}
