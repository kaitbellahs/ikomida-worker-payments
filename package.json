{
  "name": "ikomida-payments-worker",
  "version": "1.0.1",
  "description": "ikomida payments worker",
  "private": true,
  "module": "build/worker.js",
  "types": "build/worker.d.ts",
  "files": [
    "build"
  ],
  "type": "module",
  "scripts": {
    "worker": "node build/worker.js",
    "build": "rimraf ./build ./types ./docs && rollup -c",
    "prebuild:types": "rimraf ./types",
    "build:types": "tsc -p ./tsconfig.json --outDir build && api-extractor run",
    "predoc:jsdoc": "rimraf ./docs",
    "docs:jsdoc": "jsdoc -r \"src/**/*.ts\" -R README.md -d ./docs",
    "predoc:typedoc": "rimraf ./docs",
    "docs:typedoc": "typedoc src --out docs",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint . --ext .ts --quiet --fix",
    "clean": "rimraf ./build ./types ./docs",
    "glogin": "artifactregistry-auth"
  },
  "author": "Khalid Ait Bellahs",
  "license": "UNLICENSED",
  "dependencies": {
    "@ikomida/shared-backend": "^0.2.12",
    "body-parser": "^1.20.0",
    "cors": "^2.8.5",
    "express": "^4.18.1",
    "jsonwebtoken": "^8.5.1",
    "uuid": "^9.0.0",
    "axios": "^0.27.2"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.32.0",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^14.1.0",
    "@rollup/plugin-typescript": "^8.5.0",
    "@types/amqplib": "^0.8.2",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.14",
    "@types/linkify-it": "^3.0.2",
    "@types/luxon": "^3.0.1",
    "@types/node": "^18.8.1",
    "@types/node-mailjet": "^3.3.9",
    "@types/sequelize": "^4.28.14",
    "@types/sharp": "^0.31.0",
    "@typescript-eslint/eslint-plugin": "^5.39.0",
    "@typescript-eslint/parser": "^5.39.0",
    "chai": "^4.3.6",
    "eslint": "^8.24.0",
    "eslint-config-prettier": "^8.5.0",
    "google-artifactregistry-auth": "^3.0.2",
    "jsdoc": "^3.6.11",
    "linkify-it": "^4.0.1",
    "mocha": "^10.0.0",
    "prettier": "^2.7.1",
    "rimraf": "^3.0.2",
    "rollup": "^2.79.1",
    "rollup-plugin-auto-external": "^2.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "tslib": "^2.4.0",
    "typedoc": "^0.23.15",
    "typescript": "^4.8.4"
  }
}